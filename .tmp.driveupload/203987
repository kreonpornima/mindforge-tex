function replaceDdIdWithDdVal(data) {
    let newData = { ...data }; // Copy the original object

    Object.keys(data).forEach(key => {
        if (key.endsWith("_ddID")) {
            let baseKey = key.replace("_ddID", "");
            let newKey = baseKey + "_ddVal";

            if (baseKey in data) {
                newData[newKey] = newData[baseKey]; // Move original key value to _ddVal
                newData[baseKey] = newData[key]; // Replace original key value with _ddID value
            }

            delete newData[key]; // Remove the old _ddID key
        }
    });

    return newData;
}

function setRowData(newData) {
  newData = replaceDdIdWithDdVal(newData);
  rowData = [newData, ...rowData]; // Prepend new data to the rowData array

  // Apply the transaction to add the new row at the top
  gridApi.applyTransaction({
    add: [newData],
    addIndex: 0, // Specify the index where the row should be added
  });

