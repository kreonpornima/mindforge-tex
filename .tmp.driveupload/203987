    var reg = /^(?:(?:1[6-9]|[2-9]\d)?\d{2})(?:(?:(\/|-|\.)(?:0?[13578]|1[02])\1(?:31))|(?:(\/|-|\.)(?:0?[13-9]|1[0-2])\2(?:29|30)))$|^(?:(?:(?:1[6-9]|[2-9]\d)?(?:0[48]|[2468][048]|[13579][26])|(?:(?:16|[2468][048]|[3579][26])00)))(\/|-|\.)0?2\3(?:29)$|^(?:(?:1[6-9]|[2-9]\d)?\d{2})(\/|-|\.)(?:(?:0?[1-9])|(?:1[0-2]))\4(?:0?[1-9]|1\d|2[0-8])$/;
    return reg.test(date);
    // return date && Object.prototype.toString.call(date) === "[object Date]" && !isNaN(date);
  }

function dateFormatter(params) {
    console.log("dateFormatter",params)
    if (!params || !params.value) return null;

    let dateAsString = params.value;

    // If the value is an object with a 'date' property, extract the date
    if (typeof dateAsString === 'object' && dateAsString.date) {
        dateAsString = dateAsString.date;
    }

    // If it's a Date object, format it as YYYY-MM-DD
    if (dateAsString instanceof Date) {
        return dateAsString.toISOString().split("T")[0]; // YYYY-MM-DD
    }

    // Remove time if the format is 'YYYY-MM-DD HH:MM:SS.SSSSSS'
    if (typeof dateAsString === 'string' && dateAsString.includes(" ")) {
        dateAsString = dateAsString.split(" ")[0]; // Extract YYYY-MM-DD
    }

    // Convert DD-MM-YYYY → YYYY-MM-DD if needed
    if (typeof dateAsString === 'string' && dateAsString.includes('-')) {
        let dateParts = dateAsString.split("-");
        
        // If format is already YYYY-MM-DD, return as is
        if (dateParts[0].length === 4) {
            return dateAsString;
        }

        // Convert from DD-MM-YYYY to YYYY-MM-DD
        return `${dateParts[2]}-${dateParts[1]}-${dateParts[0]}`;
    }

    return dateAsString; // Return cleaned date
}
  
  function dateComparator(date1, date2) {
    console.log("dateComparator", date1, date2)
    if (!date1 || !date2) return 0;

    let d1 = new Date(date1);
    let d2 = new Date(date2);
    console.log("datecomparator",d1-d2);
