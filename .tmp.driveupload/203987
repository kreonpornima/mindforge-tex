  // Add tab navigation logic to gridOptions
  gridOptions.tabToNextCell = function (params) {
    const previous = params.previousCellPosition;
    const colId = previous.column.getColId();
    const rowPinned = previous.rowPinned;
    // Only customize tabbing for pinned top row
    if (rowPinned === 'top') {
      const allCols = gridApi.getAllDisplayedColumns();
      const currentIndex = allCols.findIndex(col => col.getColId() === colId);

      // If it's NOT the last column (and not "Actions" col), go to next column
      if (currentIndex >= 0 && currentIndex < allCols.length - 2) {
        return {
          rowIndex: previous.rowIndex,
          column: allCols[currentIndex + 1],
          rowPinned: 'top'
        };
      }

      // If it's the last editable field (before actions column), move focus to Add Button
      if (currentIndex === allCols.length - 2) {
        setTimeout(() => {
          const addButton = document.getElementById('addRowButton');
          if (addButton) 
            addButton.focus();
            // Trigger the click automatically on focus
            addButton.click();
        }, 0);

        return null; // Prevent default focus
      }

      return null; // Prevent jumping to main grid
    }

    // Default tab behavior for non-pinned rows
    return params.nextCellPosition;
  };


  
  function onDeleteRow(rowData) {
    if (!confirm(`Are you sure you want to delete this entry?`)) {
      return;
    }
    var rd = rowData;
    rd.FormID = <?php echo $FormID; ?>;
    fetch('putDeleteForAGForm.php', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(rd) // send full row data
    })
      .then(response => response.json())
      .then(result => {
        if (result.success) {
          alert('Entry deleted successfully!');
          gridApi.applyTransaction({ remove: [rowData] });
        } else {
          alert(`Failed to delete entry: ${result.error || 'Unknown error'}`);
        }
      })
      .catch(error => {
        console.error('Error deleting entry:', error);
        alert('An error occurred during deletion.');
      });
  }

  function formatDateForEditing(input, formatType = 1) {
      // formatType = 1 for dd-mm-yyyy
      // formatType = 2 for yyyy=mm-dd
      let dateObj;

      // Case 1: If input is already a Date object
      if (input instanceof Date && !isNaN(input.getTime())) {
          dateObj = input;
      }
      // Case 2: If input is an object with a "date" property
      else if (typeof input === "object" && input !== null && "date" in input) {
          dateObj = new Date(input.date);
      }
      // Case 3: Invalid input
      else {
          return null;
      }

      // Format the date as YYYY-MM-DD
      const year = dateObj.getFullYear();
      const month = String(dateObj.getMonth() + 1).padStart(2, "0"); // Ensure two-digit month
      const day = String(dateObj.getDate()).padStart(2, "0"); // Ensure two-digit day

      // if(+formatType == 2)
      //   return `${year}/${month}/${day}`;
      // return `${day}/${month}/${year}`;
      let formattedDate = +formatType === 2 ? `${year}/${month}/${day}` : `${day}/${month}/${year}`;

    console.log("Formatted Date:==>", formattedDate); // Log the formatted date
    return formattedDate;
  }

  function generateCheckboxHTML(groupColIds) {
    console.log("groupColIds & checkboxState", groupColIds, checkboxState);
    return groupColIds.map(id => `
