	//User Transaction Log
	public function addToTransactionLog($query, $error = ''){
		$enableTransactionFileLog = 0;
		//disabled logs for preview page, list view page & fetch.php
		if(isset($_REQUEST['preview']) || ($_REQUEST['view'] ?? 0) > 0 || "$_SERVER[REQUEST_URI]" === '/fetch.php'){
			$enableTransactionFileLog = 1;
		}
		// as the data $_REQUEST is repeatedly added, we want it only once per page:
		if($_SESSION['lastLoggedPage'] === "$_SERVER[REQUEST_URI]"){
			$newPage = PHP_EOL . "-------------------------";
		}else{
			$newPage = PHP_EOL. "-------------------------".
					PHP_EOL. "User: ".$_SESSION['email'].' - '.$_SERVER['REMOTE_ADDR'] . ' - ' . date("F j, Y, g:i:s a") .
					PHP_EOL. ( "https://$_SERVER[HTTP_HOST]$_SERVER[REQUEST_URI]" ).
					PHP_EOL. "NEW PAGE => Data: ".json_encode($_REQUEST).
					PHP_EOL. "-------------------------";
		}
		if(strlen($error) > 1) $error = PHP_EOL . $error;
		date_default_timezone_set('Asia/Calcutta'); 
		$devLog  =  $newPage . 
					PHP_EOL. $query . $error;
		
		$_SESSION['lastLoggedPage'] = "$_SERVER[REQUEST_URI]";

		if(!$enableTransactionFileLog){
			$LFN = str_replace([' ', '.'], '-', (string)($_SESSION['logFileName'] ?? "login"));
			file_put_contents('./logs/'.$LFN.'.log', $devLog, FILE_APPEND);
		}

	}

