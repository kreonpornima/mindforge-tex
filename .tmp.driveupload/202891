	public function db_insert($table, $set, $val, $line ="") { ///returns should have at least 1 set & set==val
		
		if(strpos($_SERVER['REQUEST_URI'],"/db.php") !== false){
			$this->enableLog = 1;
		}

		// if(isset($_REQUEST['preview'])){
		// 	$enableTransactionFileLog = 1;
		// }

		$output = array();
		$output['error'] = "1";
		$output['error_statement'] = "";
		if(!(strlen($table) > 0 && sizeof($set) > 0 && sizeof($set) == sizeof($val))){
			$output['error_statement'] = "Invalid Arguments";
			return $output;
		}

		$s1 = "INSERT INTO ".$table." ("; 
		$s2 = " ";

		$separator = "";
		for($i = 0; $i < sizeof($set); $i++){
			$s1 .= $separator . $set[$i];

			//Updated by pornima on 5-11-2024
			if(strpos($val[$i], 'SqlQueryOnInsert') !== false){
				$s2 .= $separator . str_replace('SqlQueryOnInsert', '', $val[$i]);
			}else if(strpos($set[$i], 'uniqueid') !== false){
				$s2 .= $separator . "" . $val[$i];
			}else{
				$s2 .= $separator . "'" . $this->real_escape_string($val[$i]) . "'";
			}
			// $s2 .= $separator . "'" . mysqli_real_escape_string($this, $val[$i]) . "'";
			$separator = ",";
		}
		$sql = $s1 . " ) Values( " . $s2 . ")";

		// echo $sql;
		
		$sql = $sql . " SELECT SCOPE_IDENTITY() as id";
		// date_default_timezone_set('Asia/Calcutta'); 
		// $devLog  = PHP_EOL."-------------------------".PHP_EOL."User: ".$_SESSION['email'].' - '.$_SERVER['REMOTE_ADDR'] . ' - ' . date("F j, Y, g:i a")." => Data: ".json_encode($_REQUEST).PHP_EOL. ( "https://$_SERVER[HTTP_HOST]$_SERVER[REQUEST_URI]" ).PHP_EOL.$sql;
		if ($result = sqlsrv_query($this->conn, $sql)) {
			sqlsrv_next_result($result);
			$row = sqlsrv_fetch_array($result);
			$output['error'] = "0";
			$output['last_id'] = $row["id"]; //returns 0 if PK not set/AI
			// print_r($output);
			//Check log is enabled
			if($this->enableLog == 1){

				if($_POST['editID']){
					$editid = $_POST['editID'];
				}else{
					$editid = $output['last_id'];
				}

				// Build an associative array from $set and $val
				$logData = [];
				for ($i = 0; $i < count($set); $i++) {
					$key = $set[$i];

					// Handle values like SqlQueryOnInsert or plain values
					if (strpos($val[$i], 'SqlQueryOnInsert') !== false) {
						$value = str_replace('SqlQueryOnInsert', '', $val[$i]);
					} else {
						$value = $val[$i];
					}

					// Decode if it's JSON-looking, else keep it as-is
					$decodedValue = json_decode($value, true);
					$logData[$key] = $decodedValue !== null ? $decodedValue : $value;
				}

				// Convert to JSON string
				$jsonNewValue = json_encode($logData, JSON_UNESCAPED_UNICODE);

				// Optional: escape single quotes for SQL
				$escapedJsonNewValue = str_replace("'", "''", $jsonNewValue);

				// LOG NEW DATA IN LOGS TABLE
				$log_sql = "INSERT INTO logs (Mode, field, oldValue, newValue, CompanyId, DivisionId, YearCode, EditId, EntryId ,FormID, CreatedBy) 
				VALUES ('ADD', '', '', '{$escapedJsonNewValue}', '{$_SESSION['dbCompany']}', '{$_SESSION['dbDivision']}', '{$_SESSION['dbYear']}', $editid, {$output['last_id']}, '{$_POST['FormID']}', '{$_SESSION['user_id']}')";
				// exit();
				$Result = db::getInstance()->db_insertQuery($log_sql);
			}

		} else {
			$output['error'] = "1";
			$error_array = sqlsrv_errors();
			$output['error_statement'] =  "Error: " . $error_array[0]['message'];
			// $devLog .= PHP_EOL . $output['error_statement'];
		}

		// if(!$enableTransactionFileLog){
		// 	file_put_contents('./logs/'.$_SESSION['email'].'.log', $devLog, FILE_APPEND);
		// }
		$this->addToTransactionLog($sql, $output['error_statement']);
		$this->addToSqlProfiler($line . ": " . $sql);
		return $output;
	}

	public function real_escape_string($value){	
		//COMMENTED BY MITESH ON 14/10/24 NEED OTHER SOLUTIONS ASAP**********************************************************************
		// $value = preg_replace('/[^A-Za-z0-9\-\_\?\=\.\&\s\(\)\:+]/', '', $value);
		// $value = str_replace ("'","''",$value);

		$value = str_replace(
			["‘", "’", "“", "”"],
			[" ", " ", ' ', ' '],
			$value
		);
		
		

		$value = preg_replace_callback("/(?<!')'(?!')/", function($matches) {
			return "''";
		}, $value);		

		// $value = preg_replace_callback("/(?<!['\x{2018}])'(?!['\x{2018}])/", function($matches) {
        // 	return "''";
    	// }, $value);
		return $value;
	}	
